# Copie este arquivo para .env e preencha com os dados da sua câmera.
# Não coloque espaços antes ou depois do "=".

# IP da câmera. Se a porta HTTP não for a 80, coloque junto: 192.168.1.108:8080
CAM_IP=192.168.1.108

# Usuário e senha da câmera
CAM_USER=admin
CAM_PASS=admin123

# Canal monitorado (começa em 1; -1 = todos os canais)
CAM_CHANNEL=1

# Eventos: All = todos; para filtrar, use colchetes: [TrafficJunction] ou [TrafficJunction,CrossLineDetection]
CAM_EVENTS=All

# Intervalo do heartbeat em segundos
HEARTBEAT=5

# true para acessar a câmera por HTTPS (o certificado não é validado)
CAM_HTTPS=false

# Pasta onde as imagens dos eventos são salvas
PASTA_IMAGENS=imagens
